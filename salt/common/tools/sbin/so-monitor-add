#!/bin/bash
set -euo pipefail

. /usr/sbin/so-common

usage() {
  read -r -d '' message <<- EOM
		usage: so-monitor-add [-h] NIC

    positional arguments:
      NIC           The interface to add to the monitor bond (ex: eth2)

    optional arguments:
      -h, --help    Show this help message and exit
	EOM
  echo "$message"
  exit 1
}

if [[ $# -eq 0 || $# -gt 1 ]] || [[ $1 == '-h' || $1 == '--help' ]]; then
  usage
fi

# Validate interface name to prevent injection
if [[ ! "$1" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    echo "ERROR: Invalid interface name: $1" >&2
    exit 1
fi

add_interface_bond0 "$1" || exit $?
