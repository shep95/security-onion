"""
Theory 6: Supply-chain and integrity pre-flight checks for Security Onion.

Usage: so-verify [--strict]
"""

import argparse
import glob
import json
import os
import stat
import sys

CHECKS = []
FAILURES = []


def check(name):
    def decorator(fn):
        CHECKS.append((name, fn))
        return fn
    return decorator


@check('local_pillar_permissions')
def local_pillar_permissions():
    root = '/opt/so/saltstack/local/pillar'
    if not os.path.isdir(root):
        return
    for dirpath, _, filenames in os.walk(root):
        for fname in filenames:
            path = os.path.join(dirpath, fname)
            mode = stat.S_IMODE(os.stat(path).st_mode)
            if mode & (stat.S_IWGRP | stat.S_IWOTH):
                FAILURES.append(f'World/group-writable pillar file: {path} (mode {oct(mode)})')


@check('security_allowlists')
def security_allowlists():
    path = '/opt/so/conf/security/allowlists.json'
    if not os.path.exists(path):
        FAILURES.append(f'Missing security allowlists: {path}')
        return
    with open(path, 'r', encoding='utf-8') as f:
        data = json.load(f)
    if data.get('version', 0) < 1:
        FAILURES.append('allowlists.json version too old')


@check('analyzer_helpers')
def analyzer_helpers():
    helpers = '/opt/so/conf/sensoroni/analyzers/helpers.py'
    if not os.path.isfile(helpers):
        return
    with open(helpers, 'r', encoding='utf-8') as f:
        content = f.read()
    for marker in ('MAX_ARTIFACT_BYTES', 'escapeWildcard', 'safeResolvePath'):
        if marker not in content:
            FAILURES.append(f'Analyzer security marker missing in helpers.py: {marker}')


@check('hypervisor_vms_schema')
def hypervisor_vms_schema():
    try:
        from so_security_utils import validate_vm_config
    except ImportError:
        return
    for vms_file in glob.glob('/opt/so/saltstack/local/salt/hypervisor/hosts/*VMs'):
        with open(vms_file, 'r', encoding='utf-8') as f:
            raw = f.read().strip()
        if not raw:
            continue
        vms = json.loads(raw)
        if not isinstance(vms, list):
            FAILURES.append(f'VMs file is not a list: {vms_file}')
            continue
        for vm in vms:
            ok, err = validate_vm_config(vm)
            if not ok:
                FAILURES.append(f'{vms_file}: {err}')


@check('sensoroni_tls')
def sensoroni_tls():
    path = '/opt/so/conf/sensoroni/sensoroni.json'
    if not os.path.isfile(path):
        return
    with open(path, 'r', encoding='utf-8') as f:
        cfg = json.load(f)
    agent = cfg.get('agent', {})
    if agent.get('verifyCert') is False:
        FAILURES.append('sensoroni.json has verifyCert=false (enable for elite deployments)')


def main():
    parser = argparse.ArgumentParser(description='Security Onion integrity verification')
    parser.add_argument('--strict', action='store_true', help='Exit non-zero on any failure')
    args = parser.parse_args()

    for name, fn in CHECKS:
        try:
            fn()
        except Exception as exc:
            FAILURES.append(f'{name}: {exc}')

    if FAILURES:
        print('so-verify FAILURES:')
        for item in FAILURES:
            print(f'  - {item}')
        sys.exit(1 if args.strict else 0)

    print('so-verify: all checks passed')
    sys.exit(0)


if __name__ == '__main__':
    main()
