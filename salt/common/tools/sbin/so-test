. /usr/sbin/so-common

set -e

# Playback live sample data onto monitor interface
if [[ ! -d /opt/samples ]] || [[ -z "$(ls -A /opt/samples/)" ]]; then
    echo "WARNING: /opt/samples/ is empty or missing. No traffic will be replayed." >&2
fi
so-tcpreplay /opt/samples/* 2>/var/log/so-test.log

# Ingest sample pfsense log entry
if is_sensor_node; then
    echo "<134>$(date '+%b %e %H:%M:%S') filterlog[31624]: 84,,,1567509287,igb0.244,match,pass,in,4,0x0,,64,0,0,DF,6,tcp,64,192.168.1.1,10.10.10.10,56320,443,0,S,3333585167,,65535,,mss;nop;wscale;nop;nop;TS;sackOK;eol" | nc -uv -w1 127.0.0.1 514 > /dev/null 2>&1
fi
